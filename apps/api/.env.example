PORT=3001
# Leave empty for direct connections. Behind a proxy, list ONLY its trusted IPs/CIDRs.
# Never use a catch-all range: the proxy must strip/overwrite incoming forwarded headers.
TRUSTED_PROXY_CIDRS=
# Production: set this to your deployed frontend origin.
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
DATABASE_URL=postgresql://postgres.your-project:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres



CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CLOUDINARY_PROPERTY_FOLDER=path/to/your/property/folder

# Optional. Lets "delete my account" also remove the Supabase sign-in identity. Server-side only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Listings not confirmed by their owner for this many days are hidden from public browsing (default 60).
LISTING_STALE_DAYS=60
# Owners are reminded after this many days without confirmation (default 45; always shorter than the stale limit).
LISTING_REMINDER_DAYS=45
# Set to true to switch off background jobs such as availability reminders.
DISABLE_SCHEDULER=false

# Item bookings are paid through PayHere (https://www.payhere.lk). Leave blank to keep payments switched off.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Use the sandbox until you go live. Set to false in production.
PAYHERE_SANDBOX=true
# The API's public address. PayHere calls it back with payment results, so localhost only works behind a tunnel.
API_PUBLIC_URL=http://localhost:3001
# The platform's fee on top of the rental, as a percentage (default 10).
BOOKING_SERVICE_FEE_PERCENT=10
# Optional comma-separated list to open categories gradually, for example PROPERTY,VEHICLE. Empty means all.
# During the homes pilot, item and vehicle booking is switched off. Set this to PROPERTY for the pilot.
# Remove or leave empty only after financial reconciliation, deposit handling and payment workflows are ready.
ENABLED_CATEGORIES=PROPERTY

# Email alerts (booking confirmed, cancelled, refund sent, listing approved) go through Resend (https://resend.com).
# Leave blank to keep alerts inside the site only. EMAIL_FROM must be an address on a domain you have verified there.
RESEND_API_KEY=
EMAIL_FROM=RentalHub Sri Lanka <hello@yourdomain.lk>
# How much a renter gets back when they cancel a paid booking. These must match the cancellation wording on the Terms page.
# Cancel at least FULL days before the start for everything back; at least PARTIAL days before for the deposit plus
# PERCENT of the rental (the service fee is kept); later than that only the deposit is returned.
CANCEL_FULL_REFUND_DAYS=7
CANCEL_PARTIAL_REFUND_DAYS=2
CANCEL_PARTIAL_REFUND_PERCENT=50
