generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  RENTER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id         String   @id @default(uuid())
  authUserId String   @unique
  role       UserRole
  email      String   @unique
  phone      String?
  createdAt  DateTime @default(now())
  accountStatus AccountStatus @default(ACTIVE)
  suspendedAt DateTime?
  suspensionReason String?

  listings        Listing[]
  rentalRequests  RentalRequest[] @relation("RenterRequests")
  assignedRequests RentalRequest[] @relation("AssignedRequests")
  adminPermission AdminPermission?
  complaints      Complaint[]
  notifications   Notification[]
  bookings        Booking[]
  payouts         OwnerPayout[]
  resolvedComplaints Complaint[] @relation("ComplaintResolver")
  adminActivities AdminActivity[]

  @@map("users")
}

model AdminPermission {
  id                  String  @id @default(uuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id])
  canApproveListings  Boolean @default(false)
  canManageAdmins     Boolean @default(false)
  canManageComplaints Boolean @default(false)
  canManagePayouts    Boolean @default(false)

 
  @@map("admin_permissions")
}

model AdminActivity {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entityType String
  entityId  String
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@map("admin_activity")
}

enum PropertyType {
  APARTMENT
  HOUSE
}

enum PropertySize {
  STUDIO
  ONE_BR
  TWO_BR
  THREE_BR_PLUS
  N_A
}

enum FurnishingStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

// What is being rented. Add values here (and a form + validation) when a category launches.
enum ListingCategory {
  PROPERTY
  VEHICLE
  EQUIPMENT
  EVENT_GEAR
}

// The period `monthlyRent` is priced per. Property is always MONTH.
enum RatePeriod {
  DAY
  WEEK
  MONTH
}

enum ListingStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  INACTIVE
}

model Listing {
  id           String       @id @default(uuid())
  // Assigned once by the approval trigger in migration 20260920000000.
  reference    String?      @unique
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id])

  category     ListingCategory @default(PROPERTY)
  // Category-specific fields for non-property categories. Property keeps its own columns below.
  attributes   Json?

  // Item categories (vehicles, equipment, event gear) show a title and description instead of the property fields.
  title        String?
  description  String?

  // Property-only fields: null for every other category.
  propertyType PropertyType?
  size         PropertySize?
  bedrooms     Int?
  bathrooms    Int?
  parking      Boolean      @default(false)
  furnishing   FurnishingStatus?

  areaText     String

  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  mapLink      String?

  // The column name predates ratePeriod: this is the rate per `ratePeriod`, in integer LKR.
  monthlyRent       Int
  ratePeriod        RatePeriod @default(MONTH)
  // Refundable amount an item renter pays up front; property uses key money instead.
  depositAmount     Int?
  minDurationMonths Int?
  keyMoney          Boolean @default(false)
  keyMoneyAmount    Int?

  ownerContact String
  photoUrls    String[]

  status                       ListingStatus @default(PENDING_APPROVAL)
  lastAvailabilityConfirmedAt  DateTime?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  deletedAt                    DateTime?
  deletedByAdminId             String?
  deletionReason               String?
  // Set when the owner has been reminded to confirm availability; cleared on reconfirmation.
  reminderSentAt               DateTime?

  matches      Match[]
  bookings     Booking[]
  blocks       ListingBlock[]

  @@index([status, category, createdAt])
  @@index([status, propertyType, areaText])
  @@index([status, monthlyRent])
  @@index([latitude, longitude])
  // Default public browse order, and an owner's own list.
  @@index([status, deletedAt, createdAt])
  @@index([ownerId, deletedAt, createdAt])
  @@map("listings")
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
}

model RentalRequest {
  id             String            @id @default(uuid())
  renterId       String
  renter         User              @relation("RenterRequests", fields: [renterId], references: [id])

  areaText       String
  budgetMin      Int?
  budgetMax      Int
  durationMonths Int
  propertyType   PropertyType
  size           PropertySize?
  bedrooms       Int?
  parking        Boolean?
  furnishing     FurnishingStatus?

  renterContact  String
  searchLatitude  Float?
  searchLongitude Float?
  searchRadiusKm  Float?
  status         RequestStatus     @default(OPEN)
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?
  deletedByAdminId String?
  deletionReason String?

  // Internal work queue fields. Never shown to renters.
  assignedAdminId String?
  assignedAdmin   User?     @relation("AssignedRequests", fields: [assignedAdminId], references: [id])
  assignedAt      DateTime?
  adminNotes      String?
  followUpAt      DateTime?

  matches        Match[]

  @@index([status, propertyType, areaText])
  @@index([assignedAdminId, status])
  // A renter's own list, and the admin queue.
  @@index([renterId, deletedAt, createdAt])
  @@index([deletedAt, createdAt])
  @@map("rental_requests")
}

enum MatchStatus {
  SUGGESTED
  SENT
  INTERESTED
  NOT_INTERESTED
  RENTED
}

model Match {
  id        String        @id @default(uuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id])
  requestId String
  request   RentalRequest @relation(fields: [requestId], references: [id])

  score     Float
  locationOverrideReason String?
  locationOverrideAdminId String?
  locationOverrideAt DateTime?
  recommendationReason String?
  recommendedByAdminId String?
  recommendationReviewedAt DateTime?
  status    MatchStatus @default(SUGGESTED)
  createdAt DateTime    @default(now())
  invalidatedAt DateTime?
  invalidationReason String?

  @@unique([listingId, requestId])
  @@index([requestId])
  @@map("matches")
}

enum ComplaintTargetType {
  LISTING
  USER
}

enum ComplaintStatus {
  OPEN
  REVIEWING
  RESOLVED
}

model Complaint {
  id         String              @id @default(uuid())
  reporterId String?
  reporter   User?               @relation(fields: [reporterId], references: [id])
  resolvedById String?
  resolvedBy User?               @relation("ComplaintResolver", fields: [resolvedById], references: [id])
  bookingId  String?             @unique
  booking    Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  disputeType DisputeType?
  targetType ComplaintTargetType
  targetId   String
  reason     String
  status     ComplaintStatus     @default(OPEN)
  adminNotes String?
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([bookingId, status, createdAt])
  @@map("complaints")
}

enum DisputeType {
  DEPOSIT
  DAMAGE
  NO_SHOW
  PAYMENT
  ITEM_CONDITION
  OTHER
}

enum NotificationType {
  ADMIN_DELETION
  AVAILABILITY_REMINDER
  BOOKING_CONFIRMED
  BOOKING_RECEIVED
  BOOKING_CANCELLED
  LISTING_APPROVED
  LISTING_REJECTED
  DISPUTE_OPENED
  DISPUTE_UPDATED
}
model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type NotificationType
  title String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

// A dated rental of an item. Unlike property, the renter pays through the platform and is not introduced by an admin.
model Booking {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  renterId  String
  renter    User    @relation(fields: [renterId], references: [id])

  // Rented from startDate up to, but not including, endDate.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  // Billing units of the listing's ratePeriod, and the rate they were priced at.
  units     Int
  rateAmount Int
  rentalTotal Int
  serviceFee  Int
  depositAmount Int
  // What the renter pays: rentalTotal + serviceFee + depositAmount, in whole LKR.
  totalAmount Int

  renterContact String
  status        BookingStatus @default(PENDING_PAYMENT)
  // An unpaid booking stops blocking the dates after this moment.
  expiresAt     DateTime?
  paidAt        DateTime?
  paymentReference String?
  cancelledAt   DateTime?
  cancelledBy   CancelledBy?
  cancelReason  String?
  // Money owed back to the renter after a cancellation. Refunds are made by hand in PayHere, then marked done here.
  refundAmount    Int          @default(0)
  refundStatus    RefundStatus @default(NONE)
  refundedAt      DateTime?
  refundReference String?
  ownerPayout     OwnerPayout?
  dispute         Complaint?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([listingId, status, startDate, endDate])
  @@index([refundStatus])
  @@index([renterId, createdAt])
  @@map("bookings")
}

enum OwnerPayoutStatus {
  DUE
  PAID
  CANCELLED
}

// A manually reviewed amount owed to an owner for a completed item booking.
// This records an obligation and transfer reference; it never initiates a transfer.
model OwnerPayout {
  id           String           @id @default(uuid())
  bookingId    String           @unique
  booking      Booking          @relation(fields: [bookingId], references: [id])
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id])
  amount       Int
  status       OwnerPayoutStatus @default(DUE)
  note         String?
  transferReference String?
  paidAt       DateTime?
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@map("owner_payouts")
}

enum CancelledBy {
  RENTER
  OWNER
  ADMIN
  SYSTEM
}

enum RefundStatus {
  NONE
  DUE
  DONE
}

// Dates an owner has taken off the calendar themselves (personal use, maintenance), so nobody can book them.
model ListingBlock {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Blocked from startDate up to, but not including, endDate: the same convention as bookings.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  @@index([listingId, startDate, endDate])
  @@map("listing_blocks")
}
