# Copy to .env.docker and fill in. Used by:  docker compose --env-file .env.docker up --build
# This file is safe to commit; .env.docker is ignored by git.

# Required. A free Supabase project handles sign-in (Authentication > Providers > Email).
# Project URL and the publishable (anon) key are under Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Without Cloudinary, photo uploads are unavailable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Without PayHere credentials, booking shows "Online payments are not set up yet".
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Optional. Without these, alerts stay inside the site and no email is sent.
RESEND_API_KEY=
EMAIL_FROM=

# Shown on the legal pages.
CONTACT_EMAIL=hello@example.com

# The local database password. Change it if the port is ever exposed.
POSTGRES_PASSWORD=rentalhub
